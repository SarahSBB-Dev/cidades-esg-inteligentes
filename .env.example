# Copie este arquivo para .env antes de subir o ambiente local:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/Mac)

# Perfil da aplicação: dev (local com MySQL), stg (staging) ou prd (produção)
PROFILE=dev

# Banco de dados MySQL usado pelo docker-compose
DB_NAME=esg
DB_ROOT_PASSWORD=troque_esta_senha
