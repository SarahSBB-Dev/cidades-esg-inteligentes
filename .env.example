# Copie este arquivo para .env antes de subir o ambiente local:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/Mac)

# Perfil da aplicação: dev (local), stg (staging) ou prd (produção)
PROFILE=dev

# Banco de dados MySQL usado pelo docker-compose
DB_NAME=esg
DB_ROOT_PASSWORD=troque_esta_senha

# Imagem da API. Localmente fica vazio (a imagem é construída pelo Dockerfile).
# Nos deploys, o pipeline usa a imagem publicada no Docker Hub, ex.: usuario/cidades-esg-inteligentes:<sha>
# APP_IMAGE=
